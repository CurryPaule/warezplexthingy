# NocoDB connection
NOCODB_URL=http://localhost:8080
NOCODB_API_KEY=nc_pat_your_api_key_here
NOCODB_BASE_ID=p_your_base_id_here

# NocoDB table IDs (find these in NocoDB URL when viewing the table)
NOCODB_WATCHLIST_TABLE_ID=md_xxxxxxxxxxxx
NOCODB_MATCHES_TABLE_ID=md_xxxxxxxxxxxx
NOCODB_STATE_TABLE_ID=md_xxxxxxxxxxxx

# Warez.cx API base URL
WAREZ_API_BASE=https://api.warez.cx

# Optional: extra headers for warez API (if reverse engineering requires them)
# WAREZ_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# WAREZ_COOKIE=

# Scraper behaviour
# Delay between API queries in milliseconds (rate limiting)
SEARCH_DELAY_MS=1500
# Default quality filter for synced watchlist items (720p, 1080p, 2160p, or "any")
DEFAULT_QUALITY=1080p
# Default required language(s) for synced watchlist items (comma-separated, e.g. GER or GER,ENG)
DEFAULT_LANG=GER
# Default tags for synced watchlist items (comma-separated, e.g. HDR,H265, or empty)
DEFAULT_TAGS=
# Preferred release groups in priority order (comma-separated, e.g. VECTOR,WAYNE,ZeroTwo,WAREZCX,SAUERKRAUT)
PREFERRED_GROUPS=
# Hours to wait for a series's pinned release group/source (AutoTags) before falling back to same HDR/SDR + codec (default: 48)
AUTOTAGS_FALLBACK_HOURS=48

# Ombi (optional — syncs approved requests into the NocoDB watchlist)
# OMBI_URL=http://localhost:3579
# OMBI_API_KEY=your-ombi-api-key
# Days before a movie's digitalReleaseDate to enable scanning (default: 7)
# OMBI_MOVIE_DIGITAL_LOOKAHEAD_DAYS=7
# Days before a series episode's airDate to enable scanning (default: 1)
# OMBI_SERIES_AIRDATE_LOOKAHEAD_DAYS=1

# JDownloader (required for 'push' mode)
# MyJDownloader account credentials
JDOWNLOADER_EMAIL=your-email@example.com
JDOWNLOADER_PASSWORD=your-myjdownloader-password
# Device name as shown in MyJDownloader web UI (e.g. "JDownloader@NAS")
JDOWNLOADER_DEVICE_NAME=JDownloader@NAS
# Auto-start downloads after pushing links (true/false)
JDOWNLOADER_AUTOSTART=false
# Comma-separated hoster priority — first available hoster wins
JDOWNLOADER_HOSTER_PRIORITY=ddownload,rapidgator

# REST API server
API_PORT=3000

# FileBrowser (required for 'sort' mode)
# FILEBROWSER_URL=http://localhost:8082
# FILEBROWSER_USERNAME=admin
# FILEBROWSER_PASSWORD=your-password
# Path where JDownloader downloads to (in FileBrowser's filesystem)
# FILEBROWSER_DOWNLOAD_PATH=/downloads
# Media library paths (in FileBrowser's filesystem)
# MEDIA_MOVIES_PATH=/media/movies
# MEDIA_SHOWS_PATH=/media/shows
